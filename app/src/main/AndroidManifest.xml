<?xml version="1.0" encoding="utf-8"?>
<!--
  Used by both packaging paths:
   * cargo-apk generates its own manifest from [package.metadata.android];
     this file documents/mirrors the same configuration for the Gradle path.
   * android:extractNativeLibs="true" keeps libmain.so loadable on API < 23
     layouts and matches cargo-apk defaults.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gearcompat.rust">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Slint's FemtoVG renderer draws through EGL + OpenGL ES 2.0. Every
         GLES 3.x device (and thus every 165 Hz panel shipping today) is
         backwards compatible; declaring 2.0 keeps minSdk 24 honest. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <!-- Optional Vulkan path (renderer-skia-vulkan / wgpu builds advertise it).
         Not required so GLES-only devices still install. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:label="Gear Compat"
        android:hasFragileUserData="false"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:extractNativeLibs="true">

        <!-- Slint's backend-android-activity drives NativeActivity. The
             `android.app.lib_name` meta-data tells the loader which cdylib to
             dlopen (renamed to libmain.so by cargo-apk/cargo-ndk); Slint's
             android-activity integration exports `android_main` from that .so
             and calls the app's `slint_main`. -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">

            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />

            <!-- High-refresh surfaces: request the display's native mode; the
                 compositor grants up to 165 Hz where the panel supports it. -->
            <meta-data
                android:name="android.max_aspect"
                android:value="2.4" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
